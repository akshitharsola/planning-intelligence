DATABASE_URL=postgresql://planning:planning@localhost:5432/planning_intelligence
DATA_DIR=./data
LOG_LEVEL=INFO

# Chat feature (natural-language Q&A on the dashboard) needs a reachable
# Ollama instance. Defaults below assume Ollama running locally with
# llama3.1:8b pulled (`ollama pull llama3.1:8b`). See
# docs/jetson-ollama-setup.md if you want to host it on a separate machine
# instead of locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
